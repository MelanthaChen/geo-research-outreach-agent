# Sending is not implemented. This defensive default is reserved for later phases.
SEND_MODE=dry_run
OUTREACH_DATABASE_URL=sqlite:///data/outreach.db
OUTREACH_LOG_LEVEL=INFO

OUTREACH_ADMIN_EMAIL=chen.yuxuan9@northeastern.edu
# Generate locally with: uv run python scripts/init_admin_password.py --output /secure/path/admin-password-hash
OUTREACH_ADMIN_PASSWORD_HASH=
# Required in hosted environments. Keep session secrets and hashes in Render secret env vars.
OUTREACH_COOKIE_SECURE=true
