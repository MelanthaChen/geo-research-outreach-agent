# Sending is not implemented. This defensive default is reserved for later phases.
SEND_MODE=dry_run
OUTREACH_DATABASE_URL=sqlite:///data/outreach.db
OUTREACH_LOG_LEVEL=INFO

OUTREACH_ADMIN_EMAIL=chen.yuxuan9@northeastern.edu
# Generate locally with: uv run python scripts/init_admin_password.py --output /secure/path/admin-password-hash
OUTREACH_ADMIN_PASSWORD_HASH=
# Required in hosted environments. Keep session secrets and hashes in Render secret env vars.
OUTREACH_COOKIE_SECURE=true

# AI personalization is paid and remains disabled until an owner authorizes a bounded pilot.
OUTREACH_AI_PERSONALIZATION_ENABLED=false
OUTREACH_AI_PERSONALIZATION_MODEL=gpt-5.4-mini-2026-03-17
OUTREACH_AI_PERSONALIZATION_MAX_CANDIDATES_PER_RUN=5
OUTREACH_AI_PERSONALIZATION_RUN_BUDGET_USD=0
OUTREACH_AI_PERSONALIZATION_CUMULATIVE_BUDGET_USD=0
OUTREACH_AI_PERSONALIZATION_MAX_COST_PER_CANDIDATE_USD=0
OUTREACH_AI_PERSONALIZATION_REPROCESS_ENABLED=false
OUTREACH_AI_PERSONALIZATION_REPROCESS_CANDIDATE_IDS=
OUTREACH_AI_PERSONALIZATION_OPERATION_ID=initial
